# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Datos y modelos (se versionan con DVC, no con Git)
# (data/raw/ y models/ los maneja el .gitignore que genera `dvc add`; un patrón
#  carpeta/* hace que DVC ignore la carpeta entera y no encuentre los .dvc)
data/raw/*.csv
data/processed/*
data/reference/*
!data/processed/.gitkeep
!data/reference/.gitkeep

# MLflow / DVC locales
mlruns/
mlflow.db
.dvc/cache/

# Entornos y variables sensibles
.env
*.log

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/